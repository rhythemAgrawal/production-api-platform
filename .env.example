# Copy to .env and adjust. Used when running the API on your machine;
# docker compose sets its own values for the api container.

# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/production_api_platform

# RSA key pair for signing access tokens. See the README for how to generate it.
JWT_PRIVATE_KEY_PATH=backend/.secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=backend/.secrets/jwt_public_key.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=600

REDIS_URL=redis://localhost:6379/0

OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4320
APP_NAME=production-api-platform
ENVIRONMENT=dev
